{
  "expo": {
    "name": "FODX Scanner",
    "slug": "fodx-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fodx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1D3A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fodx.scanner"
    },
    "android": {
      "package": "com.fodx.scanner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1D3A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "react-native-document-scanner-plugin",
        { "cameraPermission": "FODX Scanner uses the camera to scan your documents. Scans stay on your device." }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
